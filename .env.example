# KI-Provider: "claude" (kostenpflichtig, Cloud) oder "ollama" (kostenlos, lokal)
AI_PROVIDER=ollama

# Ollama (nur wenn AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic/Claude (nur wenn AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...

# Slack-Bot (Pflicht fuer Slack-Integration)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Optional — PFLICHT fuer den Nachrichten-Bus und /gpt/*, /ai/* (sonst 503)
GENESIS_API_KEY=

# ChatGPT-Bruecke (/gpt/ask, /gpt/dialog, Slack "frag gpt: ...") — LEANS_OS_BUS.md
# Schluessel von platform.openai.com; ein ChatGPT-Abo allein reicht dafuer NICHT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048
DIALOG_MAX_RUNDEN=6

# Nachrichten-Bus (LEANS OS): Austausch mit anderen KI-Systemen ueber einen Ordner.
# Entweder ein GCS-Bucket (empfohlen, ~Echtzeit per Pub/Sub-Push) ...
BUS_GCS_BUCKET=
BUS_PREFIX=bus
# ... oder ein normaler Ordner (lokal / gemountetes Laufwerk)
BUS_DIR=/tmp/leans-os-bus
BUS_MAX_BYTES=100000
BUS_MAX_TICK=10

# Social-Posting (/post-social): Instagram-Reels + YouTube-Shorts — siehe SOCIAL_SETUP.md
META_ACCESS_TOKEN=
IG_USER_ID=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Mailer (mailer/send_mails.py) — Versand der Klima-Anschreiben per Gmail-SMTP
# App-Passwort bei aktivierter 2-Faktor-Anmeldung erzeugen (16 Zeichen).
GMAIL_USER=leanstechgmbh@gmail.com
GMAIL_APP_PASSWORD=
MAIL_ABSENDER=Semir Redzic
MAIL_FIRMA=LeansTech GmbH
MAIL_WEBSITE=www.leanstech-klima.de
